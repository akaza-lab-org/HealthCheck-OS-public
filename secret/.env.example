# --- AI Configuration ---
# VERTEX_AI=1: Google Cloud Vertex AI を使用
# VERTEX_AI=0: Google AI Studio を使用（デフォルト）
VERTEX_AI=1

# Google AI Studio 用 (VERTEX_AI=0 の場合に必要)
# 発行URL: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Vertex AI 用 (VERTEX_AI=1 の場合に必要)
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- モデル設定 ---
# 利用可能: gemini-3.1-pro-preview, gemini-3.0-flash-preview, gemini-3.1-flash-lite-preview
DEFAULT_GEMINI_MODEL=gemini-3.0-flash-preview
